{
  "name": "nps-report",
  "version": "0.1.0",
  "description": "Report broken things in US National Parks — a Hono + Cloudflare Worker API/CLI that wraps the NPS per-park sendemail.cfm contact form (modeled on improvebayarea.com).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ./wrangler.toml --env=",
    "deploy": "npm run check && wrangler deploy --config ./wrangler.toml --env=",
    "tail": "wrangler tail",
    "types": "wrangler types --config ./wrangler.toml --env=",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "harvest": "tsx scripts/harvest-parks.ts",
    "report": "tsx scripts/report.ts",
    "gate:release": "npm run lint && npm run typecheck && npm test && npm audit --ignore-scripts --audit-level=low",
    "check": "wrangler deploy --dry-run --config ./wrangler.toml --env= --outdir dist && npm run test:harness",
    "test:harness": "node scripts/runtime-harness.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^25.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12",
    "wrangler": "~4.151.3"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.0",
      "sharp": "^0.35.0"
    },
    "vite": {
      "postcss": "^8.5.23"
    }
  }
}
